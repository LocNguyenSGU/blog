---
import type { Locale } from '../utils/i18n';
import type { CategoryKey } from '../utils/categories';
import { getCategoryDescription, getCategoryLabel, getCategoryUrl } from '../utils/categories';

interface Props {
  slug: CategoryKey;
  locale: Locale;
  count?: number;
}

const { slug, locale, count } = Astro.props;
const categoryUrl = getCategoryUrl(slug, locale);
---

<a
  href={categoryUrl}
  class="block card p-6"
>
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="font-serif text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">
      {getCategoryLabel(slug, locale)}
    </h3>
    {typeof count === 'number' && (
      <span class="chip text-gray-700 dark:text-gray-200">
        {count}
      </span>
    )}
  </div>
  <p class="text-sm text-gray-600 dark:text-gray-400">
    {getCategoryDescription(slug, locale)}
  </p>
</a>
