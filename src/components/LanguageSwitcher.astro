---
import type { Locale } from '../utils/i18n';
import { Languages, Check } from '@lucide/astro';

interface Props {
  currentLocale?: Locale;
}

const { currentLocale = 'vi' } = Astro.props;
---

<div class="relative">
  <button
    id="lang-toggle"
    type="button"
    class="px-3 py-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors text-sm font-medium uppercase flex items-center gap-1"
    aria-label="Switch language"
  >
    <Languages class="w-4 h-4" aria-hidden="true" />
    <span id="current-lang-text">{currentLocale}</span>
  </button>
  
  <div id="lang-menu" class="hidden absolute right-0 mt-2 w-40 bg-white dark:bg-gray-800 sepia:bg-sepia-50 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 sepia:border-sepia-300 z-50">
    <button data-lang="vi" class="w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 sepia:hover:bg-sepia-200 rounded-t-lg flex items-center justify-between gap-3">
      <span>Tiếng Việt</span>
      <Check data-lang-check="vi" class="w-4 h-4 opacity-0" aria-hidden="true" />
    </button>
    <button data-lang="en" class="w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 sepia:hover:bg-sepia-200 rounded-b-lg flex items-center justify-between gap-3">
      <span>English</span>
      <Check data-lang-check="en" class="w-4 h-4 opacity-0" aria-hidden="true" />
    </button>
  </div>
</div>

<script>
  const updateLanguageUI = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const currentLang = urlParams.get('lang') || localStorage.getItem('locale') || 'vi';
    
    const text = document.getElementById('current-lang-text');
    const checks = document.querySelectorAll('[data-lang-check]');
    
    if (text) {
      text.textContent = currentLang.toUpperCase();
    }

    checks.forEach((el) => {
      const lang = el.getAttribute('data-lang-check');
      el.classList.toggle('opacity-0', lang !== currentLang);
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');
    const langButtons = document.querySelectorAll('[data-lang]');
    
    // Update UI on page load
    updateLanguageUI();
    
    // Toggle menu
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('hidden');
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
    
    // Switch language
    langButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const lang = button.getAttribute('data-lang');

        if (lang) {
          // Save to localStorage
          localStorage.setItem('locale', lang);
          
          // Check if we're on a blog post page
          const path = window.location.pathname;
          
          const isBlogPost = path.startsWith('/blog/') && path !== '/blog' && path !== '/blog/';
          
          const isBookDetail = path.startsWith('/books/') && path !== '/books' && path !== '/books/';
          
          if (isBlogPost || isBookDetail) {
            // Determine prefix
            const prefix = isBlogPost ? '/blog/' : '/books/';
            
            // Extract current slug from path (remove trailing slash if present)
            let currentSlug = path.replace(prefix, '').replace(/\/$/, '');
            
            // Posts follow pattern: slug.en/slug.vi OR slugen/slugvi (Astro may remove dots)
            let translatedSlug = currentSlug;
            
            // Check both formats: with dot (.en, .vi) or without dot (en, vi at end)
            if (currentSlug.endsWith('.en')) {
              translatedSlug = currentSlug.replace(/\.en$/, '.' + lang);
            } else if (currentSlug.endsWith('.vi')) {
              translatedSlug = currentSlug.replace(/\.vi$/, '.' + lang);
            } else if (currentSlug.endsWith('en')) {
              // Without dot format (e.g., building-blog-with-aien)
              translatedSlug = currentSlug.replace(/en$/, lang);
            } else if (currentSlug.endsWith('vi')) {
              // Without dot format (e.g., building-blog-with-aivi)
              translatedSlug = currentSlug.replace(/vi$/, lang);
            }

            // Redirect to translated post
            const newUrl = prefix + translatedSlug + '?lang=' + lang;
            window.location.href = newUrl;
            return;
          }
          
          // Default behavior: just update language parameter
          const url = new URL(window.location.href);
          url.searchParams.set('lang', lang);
          window.location.href = url.toString();
        }
      });
    });
  });
</script>
