---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import StarRating from './StarRating.astro';
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';

interface Props {
  title: string;
  author: string;
  coverImage: ImageMetadata;
  rating: number;
  startDate: Date;
  endDate: Date;
  category: string;
  review: string;
  lang?: Locale;
  slug: string;
}

const { title, author, coverImage, rating, startDate, endDate, category, review, lang = 'vi', slug } = Astro.props;

const formatDate = (date: Date) => date.toLocaleDateString(
  lang === 'vi' ? 'vi-VN' : 'en-US',
  { month: 'short', year: 'numeric' }
);

const readPeriod = `${formatDate(startDate)} - ${formatDate(endDate)}`;

const categoryColors: Record<string, string> = {
  'tech': 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 sepia:bg-blue-200 sepia:text-blue-900',
  'fiction': 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300 sepia:bg-purple-200 sepia:text-purple-900',
  'business': 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 sepia:bg-green-200 sepia:text-green-900',
  'self-help': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 sepia:bg-yellow-200 sepia:text-yellow-900',
  'other': 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-300 sepia:bg-sepia-200 sepia:text-sepia-900',
};

const bookUrl = `/books/${slug}${lang !== 'vi' ? `?lang=${lang}` : ''}`;
---

<a href={bookUrl} class="block group">
  <article class="card">
  {/* Cover Image - 2:3 aspect ratio */}
  <div class="aspect-[2/3] overflow-hidden bg-gray-100 dark:bg-gray-900 sepia:bg-sepia-200">
    <Image 
      src={coverImage} 
      alt={title}
      width={400}
      height={600}
      format="webp"
      quality={85}
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>
  
  {/* Content */}
  <div class="p-4 space-y-2">
    {/* Category Badge */}
    <span class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${categoryColors[category] || categoryColors.other}`}>
      {t(`books.categories.${category}` as any, lang)}
    </span>
    
    {/* Title */}
    <h3 class="font-serif font-semibold tracking-tight text-lg line-clamp-2 text-gray-900 dark:text-white sepia:text-sepia-900">
      {title}
    </h3>
    
    {/* Author */}
    <p class="text-sm text-gray-600 dark:text-gray-400 sepia:text-sepia-700">
      {author}
    </p>
    
    {/* Star Rating */}
    <StarRating rating={rating} />
    
    {/* Short Review */}
    <p class="text-sm text-gray-600 dark:text-gray-400 sepia:text-sepia-700 line-clamp-3">
      {review}
    </p>
    
    {/* Read Dates */}
    <p class="text-xs text-gray-500 dark:text-gray-500 sepia:text-sepia-600">
      {readPeriod}
    </p>
  </div>
</article>
</a>
