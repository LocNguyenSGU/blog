---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import StarRating from './StarRating.astro';
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';
import { getLocalizedBookUrl } from '../utils/routing';

interface Props {
  title: string;
  author: string;
  coverImage: ImageMetadata;
  rating: number;
  startDate: Date;
  endDate: Date;
  category: string;
  review: string;
  lang?: Locale;
  slug: string;
}

const { title, author, coverImage, rating, startDate, endDate, category, review, lang = 'vi', slug } = Astro.props;

const formatDate = (date: Date) => date.toLocaleDateString(
  lang === 'vi' ? 'vi-VN' : 'en-US',
  { month: 'short', year: 'numeric' }
);

const readPeriod = `${formatDate(startDate)} - ${formatDate(endDate)}`;

const categoryColors: Record<string, string> = {
  'tech': 'bg-surface-2 text-ink-muted',
  'fiction': 'bg-surface-2 text-ink-muted',
  'business': 'bg-surface-2 text-ink-muted',
  'self-help': 'bg-surface-2 text-ink-muted',
  'other': 'bg-surface-2 text-ink-muted',
};

const bookUrl = getLocalizedBookUrl(lang, slug);
---

<a href={bookUrl} class="block group">
  <article class="card">
  {/* Cover Image - 2:3 aspect ratio */}
  <div class="aspect-[2/3] overflow-hidden bg-gray-100 dark:bg-gray-900">
    <Image 
      src={coverImage} 
      alt={title}
      width={400}
      height={600}
      format="webp"
      quality={85}
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>
  
  {/* Content */}
  <div class="p-4 space-y-2">
    {/* Category Badge */}
    <span class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${categoryColors[category] || categoryColors.other}`}>
      {t(`books.categories.${category}`, lang)}
    </span>
    
    {/* Title */}
    <h3 class="font-serif font-semibold tracking-tight text-lg line-clamp-2 text-gray-900 dark:text-white">
      {title}
    </h3>
    
    {/* Author */}
    <p class="text-sm text-gray-600 dark:text-gray-400">
      {author}
    </p>
    
    {/* Star Rating */}
    <StarRating rating={rating} />
    
    {/* Short Review */}
    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-3">
      {review}
    </p>
    
    {/* Read Dates */}
    <p class="text-xs text-gray-500 dark:text-gray-500">
      {readPeriod}
    </p>
  </div>
</article>
</a>
