---
import type { Locale } from '../utils/i18n';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  alternateUrls?: {
    vi?: string;
    en?: string;
    default?: string;
  };
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
    category?: string;
    isPartOf?: Array<Record<string, unknown>>;
    hasPart?: Array<Record<string, unknown>>;
    faqs?: Array<{
      question: string;
      answer: string;
    }>;
  };
  additionalJsonLd?: Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description,
  locale = 'vi',
  type = 'website',
  image,
  imageAlt = '',
  canonicalUrl,
  alternateUrls,
  article,
  additionalJsonLd = [],
  noindex = false,
} = Astro.props;

// Get site URL from environment or use current URL
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const currentPath = Astro.url.pathname;

// Build canonical URL (remove trailing slash except for homepage)
const canonicalPath = currentPath.endsWith('/') && currentPath !== '/' 
  ? currentPath.slice(0, -1) 
  : currentPath;
const resolvedCanonicalUrl = canonicalUrl || `${siteUrl}${canonicalPath}`;

// Build alternate language URLs
const viUrl = alternateUrls?.vi || `${siteUrl}${currentPath}?lang=vi`;
const enUrl = alternateUrls?.en || `${siteUrl}${currentPath}?lang=en`;
const defaultUrl = alternateUrls?.default || `${siteUrl}${currentPath}`;

// Full image URL for social sharing
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/images/og-default.jpg`;

// Site name
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'Personal Blog';
const authorName = import.meta.env.PUBLIC_AUTHOR_NAME || 'Anonymous';

// Build JSON-LD structured data
const buildJsonLd = () => {
  // Website schema (for homepage)
  if (type === 'website' && currentPath === '/') {
    return {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: siteUrl,
      description: description,
      inLanguage: locale === 'vi' ? 'vi-VN' : 'en-US',
      author: {
        '@type': 'Person',
        name: authorName,
      },
    };
  }

  // Blog/Article schema
  if (type === 'article' && article) {
    const blogPosting = {
      '@type': 'BlogPosting',
      headline: title,
      description: description,
      image: ogImage,
      datePublished: article.publishedTime,
      dateModified: article.modifiedTime || article.publishedTime,
      author: {
        '@type': 'Person',
        name: article.author || authorName,
      },
      publisher: {
        '@type': 'Person',
        name: authorName,
      },
      inLanguage: locale === 'vi' ? 'vi-VN' : 'en-US',
      keywords: article.tags?.join(', '),
      articleSection: article.category,
      url: resolvedCanonicalUrl,
      isPartOf: article.isPartOf,
      hasPart: article.hasPart,
    };

    const graph: Array<Record<string, unknown>> = [blogPosting];

    if (article.faqs && article.faqs.length > 0) {
      graph.push({
        '@type': 'FAQPage',
        mainEntity: article.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      });
    }

    return {
      '@context': 'https://schema.org',
      '@graph': graph,
    };
  }

  // Default webpage schema
  return {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: description,
    url: resolvedCanonicalUrl,
    inLanguage: locale === 'vi' ? 'vi-VN' : 'en-US',
  };
};

const jsonLd = buildJsonLd();
const additionalJsonLdScripts = additionalJsonLd.filter(Boolean);
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={resolvedCanonicalUrl} />

<!-- Alternate Language Links -->
<link rel="alternate" hreflang="vi" href={viUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={defaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={resolvedCanonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'vi' ? 'en_US' : 'vi_VN'} />

<!-- Article specific Open Graph tags -->
{type === 'article' && article && (
  <>
    {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.category && <meta property="article:section" content={article.category} />}
    {article.tags?.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{additionalJsonLdScripts.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
