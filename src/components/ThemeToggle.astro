---
// Theme toggle with 3 modes: Light, Sepia, Dark
import { Sun, Moon, BookOpenText } from '@lucide/astro';
---

<div class="relative">
  <button
    id="theme-toggle"
    type="button"
    class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors"
    aria-label="Change theme"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <Sun id="theme-icon-light" class="hidden w-5 h-5" aria-hidden="true" />
    <BookOpenText id="theme-icon-sepia" class="w-5 h-5" aria-hidden="true" />
    <Moon id="theme-icon-dark" class="hidden w-5 h-5" aria-hidden="true" />
  </button>
  
  <!-- Theme dropdown menu -->
  <div id="theme-menu" role="menu" class="hidden absolute right-0 mt-2 w-36 bg-white dark:bg-gray-800 sepia:bg-sepia-50 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 sepia:border-sepia-300 z-50">
    <button type="button" role="menuitemradio" aria-checked="false" data-theme="light" class="w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-700 sepia:hover:bg-sepia-200 rounded-t-lg flex items-center gap-2">
      <Sun class="w-4 h-4" aria-hidden="true" />
      Light
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme="sepia" class="w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-700 sepia:hover:bg-sepia-200 flex items-center gap-2">
      <BookOpenText class="w-4 h-4" aria-hidden="true" />
      Sepia
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme="dark" class="w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-700 sepia:hover:bg-sepia-200 rounded-b-lg flex items-center gap-2">
      <Moon class="w-4 h-4" aria-hidden="true" />
      Dark
    </button>
  </div>
</div>

<script>
  type Theme = 'light' | 'sepia' | 'dark';
  
  function getTheme(): Theme {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme') as Theme;
    }
    return 'sepia'; // Default to sepia
  }
  
  function setTheme(theme: Theme) {
    const html = document.documentElement;
    html.classList.remove('light', 'sepia', 'dark');
    html.classList.add(theme);
    localStorage.setItem('theme', theme);
    updateIcon(theme);
  }
  
  function updateIcon(theme: Theme) {
    const lightIcon = document.getElementById('theme-icon-light');
    const sepiaIcon = document.getElementById('theme-icon-sepia');
    const darkIcon = document.getElementById('theme-icon-dark');
    const themeButtons = document.querySelectorAll('[data-theme]');
    
    lightIcon?.classList.add('hidden');
    sepiaIcon?.classList.add('hidden');
    darkIcon?.classList.add('hidden');
    
    if (theme === 'light') {
      lightIcon?.classList.remove('hidden');
    } else if (theme === 'sepia') {
      sepiaIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
    }

    themeButtons.forEach((button) => {
      const isActive = button.getAttribute('data-theme') === theme;
      button.setAttribute('aria-checked', String(isActive));
    });
  }
  
  // Initialize theme
  const currentTheme = getTheme();
  setTheme(currentTheme);
  
  // Toggle menu
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('theme-toggle');
    const menu = document.getElementById('theme-menu');
    const themeButtons = document.querySelectorAll('[data-theme]');
    const closeMenu = () => {
      menu?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    };
    
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!menu?.classList.contains('hidden')));
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', () => {
      closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });
    
    // Theme selection
    themeButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const theme = (e.currentTarget as HTMLElement).getAttribute('data-theme') as Theme;
        setTheme(theme);
        closeMenu();
      });
    });
  });
</script>
