---
import type { Locale } from '../utils/i18n';
import type { TopicSlug } from '../utils/topics';
import { getTopicInfo, getTopicUrl } from '../utils/topics';

interface Props {
  slug: TopicSlug;
  locale: Locale;
  count?: number;
}

const { slug, locale, count } = Astro.props;
const topic = getTopicInfo(slug, locale);
const topicUrl = getTopicUrl(slug, locale);
---

<a
  href={topicUrl}
  class="block rounded-2xl border border-gray-200 dark:border-gray-700 sepia:border-sepia-300 bg-white dark:bg-gray-800 sepia:bg-sepia-50 p-6 hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
>
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="font-sans text-xl font-bold text-gray-900 dark:text-gray-100 sepia:text-sepia-900">
      {topic.name}
    </h3>
    {typeof count === 'number' && (
      <span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-700 sepia:bg-sepia-200 text-gray-600 dark:text-gray-300 sepia:text-sepia-800">
        {count}
      </span>
    )}
  </div>
  <p class="text-sm text-gray-600 dark:text-gray-400 sepia:text-sepia-700">
    {topic.description}
  </p>
</a>
