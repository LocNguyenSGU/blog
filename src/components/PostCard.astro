---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CategoryBadge from './CategoryBadge.astro';
import { getReadingTime, formatReadingTime } from '../utils/readingTime';
import { getPostUrl, formatDate } from '../utils/postHelpers';
import { Clock } from '@lucide/astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
const formattedDate = formatDate(new Date(post.data.pubDate), post.data.lang);
const postUrl = getPostUrl(post);
---

<article class="group card">
  <a href={postUrl} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image 
        src={post.data.coverImage} 
        alt={post.data.coverAlt}
        width={800}
        height={600}
        format="webp"
        quality={80}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
      />
      <div class="absolute top-3 left-3">
        <CategoryBadge category={post.data.category} />
      </div>
    </div>
    
    <div class="p-6">
      <h3 class="font-serif text-xl font-semibold tracking-tight mb-2 line-clamp-2">
        {post.data.title}
      </h3>
      
      {post.data.description && (
        <p class="text-gray-600 dark:text-gray-400 sepia:text-sepia-700 text-sm mb-4 line-clamp-3">
          {post.data.description}
        </p>
      )}
      
      <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 sepia:text-sepia-600">
        <time datetime={post.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span>•</span>
        <span class="flex items-center gap-1">
          <Clock class="w-4 h-4" aria-hidden="true" />
          {formatReadingTime(readingTime)}
        </span>
      </div>
    </div>
  </a>
</article>
