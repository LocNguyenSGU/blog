---
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description = 'My personal blog', locale = 'vi' } = Astro.props;
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

// Get site URL from environment or use current URL
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}${locale !== 'vi' ? `?lang=${locale}` : ''}`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <!-- SEO: Canonical and alternate language links -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={`${siteUrl}${currentPath}?lang=vi`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${currentPath}?lang=en`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${currentPath}`} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'vi' ? 'en_US' : 'vi_VN'} />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'sepia'; // Default to sepia
      })();
      
      document.documentElement.classList.remove('light', 'sepia', 'dark');
      document.documentElement.classList.add(theme);
    </script>
    
    <!-- Auto-redirect to saved language preference if no lang param -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const urlParams = new URLSearchParams(window.location.search);
        const savedLocale = localStorage.getItem('locale');
        
        // Only redirect if saved locale is valid and different from default
        if (!urlParams.has('lang') && savedLocale && (savedLocale === 'en' || savedLocale === 'vi') && savedLocale !== 'vi') {
          const url = new URL(window.location.href);
          url.searchParams.set('lang', savedLocale);
          window.location.replace(url.toString());
        }
      }
    </script>
  </head>
  <body class="min-h-screen transition-colors">
    {/* Mobile menu overlay */}
    <div id="mobile-menu-overlay" class="hidden fixed inset-0 bg-black/50 z-40 md:hidden" aria-hidden="true"></div>
    
    {/* Mobile menu sidebar */}
    <div id="mobile-menu-sidebar" class="fixed top-0 right-0 h-full w-64 bg-white dark:bg-gray-900 sepia:bg-sepia-50 shadow-xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 md:hidden">
      <div class="flex flex-col h-full">
        {/* Close button */}
        <div class="flex justify-between items-center p-4 border-b border-gray-200 dark:border-gray-700 sepia:border-sepia-300">
          <span class="font-sans font-bold text-lg">Menu</span>
          <button id="mobile-menu-close" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        {/* Navigation links */}
        <nav class="flex-1 overflow-y-auto p-4">
          <div class="flex flex-col gap-2">
            <a href="/" class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.home', locale)}</a>
            <a href="/blog" class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.blog', locale)}</a>
            <a href="/books" class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.books', locale)}</a>
            <a href="/about" class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.about', locale)}</a>
          </div>
        </nav>
        
        {/* Settings */}
        <div class="p-4 border-t border-gray-200 dark:border-gray-700 sepia:border-sepia-300">
          <div class="space-y-4">
            {/* Language Selection */}
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-2">
                {locale === 'vi' ? 'Ngôn ngữ' : 'Language'}
              </label>
              <div class="flex gap-2">
                <button 
                  data-mobile-lang="vi"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                >
                  🇻🇳 Tiếng Việt
                </button>
                <button 
                  data-mobile-lang="en"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                >
                  🇬🇧 English
                </button>
              </div>
            </div>
            
            {/* Theme Selection */}
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-2">
                {locale === 'vi' ? 'Giao diện' : 'Theme'}
              </label>
              <div class="flex gap-2">
                <button 
                  data-mobile-theme="light"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Light"
                >
                  ☀️
                </button>
                <button 
                  data-mobile-theme="sepia"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Sepia"
                >
                  📄
                </button>
                <button 
                  data-mobile-theme="dark"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Dark"
                >
                  🌙
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <header class="sticky top-0 z-30 border-b border-gray-200 dark:border-gray-700 sepia:border-sepia-300 bg-white/80 dark:bg-gray-900/80 sepia:bg-sepia-100/80 backdrop-blur-md transition-colors">
      <nav class="max-w-6xl mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <a href="/" class="text-xl md:text-2xl font-sans font-bold hover:text-blue-600 dark:hover:text-blue-400 sepia:hover:text-sepia-700 transition-colors">
            My Blog
          </a>
          
          {/* Mobile menu button */}
          <button 
            id="mobile-menu-toggle"
            class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors"
            aria-label="Toggle menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          
          {/* Desktop navigation */}
          <div class="hidden md:flex items-center gap-4">
            <div class="flex gap-6">
              <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 sepia:hover:text-sepia-700 transition-colors">{t('nav.home', locale)}</a>
              <a href="/blog" class="hover:text-blue-600 dark:hover:text-blue-400 sepia:hover:text-sepia-700 transition-colors">{t('nav.blog', locale)}</a>
              <a href="/books" class="hover:text-blue-600 dark:hover:text-blue-400 sepia:hover:text-sepia-700 transition-colors">{t('nav.books', locale)}</a>
              <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400 sepia:hover:text-sepia-700 transition-colors">{t('nav.about', locale)}</a>
            </div>
            <LanguageSwitcher currentLocale={locale} />
            <ThemeToggle />
          </div>
        </div>
      </nav>
    </header>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const mobileMenuClose = document.getElementById('mobile-menu-close');
        const mobileMenuSidebar = document.getElementById('mobile-menu-sidebar');
        const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
        
        const openMenu = () => {
          mobileMenuSidebar?.classList.remove('translate-x-full');
          mobileMenuOverlay?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        };
        
        const closeMenu = () => {
          mobileMenuSidebar?.classList.add('translate-x-full');
          mobileMenuOverlay?.classList.add('hidden');
          document.body.style.overflow = '';
        };
        
        mobileMenuToggle?.addEventListener('click', openMenu);
        mobileMenuClose?.addEventListener('click', closeMenu);
        mobileMenuOverlay?.addEventListener('click', closeMenu);
        
        // Close mobile menu when clicking on a link
        const mobileMenuLinks = mobileMenuSidebar?.querySelectorAll('a');
        mobileMenuLinks?.forEach(link => {
          link.addEventListener('click', closeMenu);
        });
        
        // Close menu on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
          }
        });
        
        // Language switching in mobile menu
        const mobileLangButtons = document.querySelectorAll('[data-mobile-lang]');
        console.log('Found language buttons:', mobileLangButtons.length);
        
        mobileLangButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const lang = btn.getAttribute('data-mobile-lang');
            console.log('Language button clicked:', lang);
            
            if (lang) {
              localStorage.setItem('locale', lang);
              
              // Handle language switching for blog/books pages
              const path = window.location.pathname;
              const isBlogPost = path.startsWith('/blog/') && path !== '/blog' && path !== '/blog/';
              const isBookDetail = path.startsWith('/books/') && path !== '/books' && path !== '/books/';
              
              if (isBlogPost || isBookDetail) {
                const prefix = isBlogPost ? '/blog/' : '/books/';
                let currentSlug = path.replace(prefix, '').replace(/\/$/, '');
                let translatedSlug = currentSlug;
                
                // Swap language suffix
                if (currentSlug.endsWith('.en')) {
                  translatedSlug = currentSlug.replace(/\.en$/, '.' + lang);
                } else if (currentSlug.endsWith('.vi')) {
                  translatedSlug = currentSlug.replace(/\.vi$/, '.' + lang);
                } else if (currentSlug.endsWith('en')) {
                  translatedSlug = currentSlug.replace(/en$/, lang);
                } else if (currentSlug.endsWith('vi')) {
                  translatedSlug = currentSlug.replace(/vi$/, lang);
                }
                
                const newUrl = prefix + translatedSlug + '?lang=' + lang;
                console.log('Redirecting to:', newUrl);
                window.location.href = newUrl;
              } else {
                // Default behavior: just update language parameter
                const url = new URL(window.location.href);
                url.searchParams.set('lang', lang);
                console.log('Redirecting to:', url.toString());
                window.location.href = url.toString();
              }
            }
          });
        });
        
        // Theme switching in mobile menu
        const mobileThemeButtons = document.querySelectorAll('[data-mobile-theme]');
        console.log('Found theme buttons:', mobileThemeButtons.length);
        
        mobileThemeButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const theme = btn.getAttribute('data-mobile-theme');
            console.log('Theme button clicked:', theme);
            
            if (theme) {
              localStorage.setItem('theme', theme);
              document.documentElement.classList.remove('light', 'sepia', 'dark');
              document.documentElement.classList.add(theme);
              updateMobileControls();
            }
          });
        });
        
        // Highlight active selections
        function updateMobileControls() {
          const urlParams = new URLSearchParams(window.location.search);
          const currentLang = urlParams.get('lang') || localStorage.getItem('locale') || 'vi';
          const currentTheme = localStorage.getItem('theme') || 'sepia';
          
          console.log('Updating mobile controls - Lang:', currentLang, 'Theme:', currentTheme);
          
          // Highlight language
          mobileLangButtons.forEach(btn => {
            const lang = btn.getAttribute('data-mobile-lang');
            btn.classList.remove('bg-blue-600', 'text-white', 'dark:text-white');
            
            if (lang === currentLang) {
              btn.classList.add('bg-blue-600', 'text-white', 'dark:text-white');
            }
          });
          
          // Highlight theme
          mobileThemeButtons.forEach(btn => {
            const theme = btn.getAttribute('data-mobile-theme');
            btn.classList.remove('ring-2', 'ring-blue-600', 'bg-blue-600', 'text-white', 'dark:text-white');
            
            if (theme === currentTheme) {
              btn.classList.add('bg-blue-600', 'text-white', 'dark:text-white');
            }
          });
        }
        
        updateMobileControls();
      });
    </script>

    <main class="max-w-6xl mx-auto px-4 py-12">
      <slot />
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-700 sepia:border-sepia-300 mt-20">
      <div class="max-w-6xl mx-auto px-4 py-8 text-center text-gray-600 dark:text-gray-400 sepia:text-sepia-700">
        <p>&copy; {new Date().getFullYear()} {t('footer.copyright', locale)}</p>
      </div>
    </footer>
  </body>
</html>
