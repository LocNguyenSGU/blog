---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';
import SEO from '../components/SEO.astro';
import { TOPICS, getTopicInfo, getTopicPillarPost } from '../utils/topics';
import { CATEGORIES, getCategoryLabel, getCategoryUrl, type CategoryKey } from '../utils/categories';
import { getPostUrl } from '../utils/postHelpers';
import { getLocalizedAboutUrl, getLocalizedBlogUrl, getLocalizedBooksUrl, getLocalizedCategoriesUrl, getLocalizedHomeUrl, getLocalizedTopicsUrl, getLocalizedTopicUrl } from '../utils/routing';
import { X, Menu as MenuIcon, Sun, Moon, BookOpenText } from '@lucide/astro';

interface ArticleMeta {
  publishedTime: string;
  modifiedTime: string;
  author: string;
  tags?: string[];
  category?: string;
  isPartOf?: Array<Record<string, unknown>>;
  hasPart?: Array<Record<string, unknown>>;
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
}

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  image?: string | ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
  alternateUrls?: {
    vi?: string;
    en?: string;
    default?: string;
  };
  article?: ArticleMeta;
  additionalJsonLd?: Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = 'My personal blog',
  locale = 'vi',
  image,
  imageAlt,
  type = 'website',
  canonicalUrl,
  alternateUrls,
  article,
  additionalJsonLd = [],
  noindex = false
} = Astro.props;
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const allPosts = await getCollection('blog');
const pillarPosts = (Object.keys(TOPICS) as Array<keyof typeof TOPICS>)
  .map((slug) => ({
    slug,
    post: getTopicPillarPost(allPosts, slug, locale),
  }))
  .filter((entry) => !!entry.post);
const topicHubs = (Object.keys(TOPICS) as Array<keyof typeof TOPICS>).map((slug) => ({
  slug,
  name: getTopicInfo(slug, locale).name,
  url: getLocalizedTopicUrl(locale, slug),
}));
const categoryHubs = (Object.keys(CATEGORIES) as CategoryKey[]).map((slug) => ({
  slug,
  label: getCategoryLabel(slug, locale),
  url: getCategoryUrl(slug, locale),
}));
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.jpg" />
    
    <!-- SEO Component (handles meta tags, Open Graph, Twitter Cards, JSON-LD) -->
    <SEO 
      title={title} 
      description={description} 
      locale={locale}
      type={type}
      image={image}
      imageAlt={imageAlt}
      canonicalUrl={canonicalUrl}
      alternateUrls={alternateUrls}
      article={article}
      additionalJsonLd={additionalJsonLd}
      noindex={noindex}
    />
    
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'sepia'; // Default to sepia
      })();
      
      document.documentElement.classList.remove('light', 'sepia', 'dark');
      document.documentElement.classList.add(theme);
    </script>
    
    <!-- Auto-redirect legacy root routes to saved locale if needed -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const savedLocale = localStorage.getItem('locale');
        const path = window.location.pathname;
        const isPrefixed = path === '/en' || path.startsWith('/en/') || path === '/vi' || path.startsWith('/vi/');

        if (!isPrefixed && savedLocale && (savedLocale === 'en' || savedLocale === 'vi') && savedLocale !== 'vi') {
          const url = new URL(window.location.href);
          url.pathname = `/${savedLocale}${path === '/' ? '' : path}`;
          window.location.replace(url.toString());
        }
      }
    </script>
  </head>
  <body
    class="min-h-screen transition-colors"
    data-alternate-vi={alternateUrls?.vi}
    data-alternate-en={alternateUrls?.en}
  >
    {/* Mobile menu overlay */}
    <div id="mobile-menu-overlay" class="hidden fixed inset-0 bg-black/50 z-40 md:hidden" aria-hidden="true"></div>
    
    {/* Mobile menu sidebar */}
    <div id="mobile-menu-sidebar" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" class="fixed top-0 right-0 h-full w-64 bg-white dark:bg-gray-900 sepia:bg-sepia-50 shadow-xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 md:hidden">
      <div class="flex flex-col h-full">
        {/* Close button */}
        <div class="flex justify-between items-center p-4 border-b border-gray-200 dark:border-gray-700 sepia:border-sepia-300">
          <span id="mobile-menu-title" class="font-serif font-semibold tracking-tight text-lg">Menu</span>
          <button id="mobile-menu-close" type="button" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors">
            <X class="w-6 h-6" aria-hidden="true" />
          </button>
        </div>
        
        {/* Navigation links */}
        <nav class="flex-1 overflow-y-auto p-4">
          <div class="flex flex-col gap-2">
            <a href={getLocalizedHomeUrl(locale)} class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.home', locale)}</a>
            <a href={getLocalizedBlogUrl(locale)} class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.blog', locale)}</a>
            <a href={getLocalizedBooksUrl(locale)} class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.books', locale)}</a>
            <a href={getLocalizedAboutUrl(locale)} class="px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 rounded-lg transition-colors font-medium">{t('nav.about', locale)}</a>
          </div>
        </nav>
        
        {/* Settings */}
        <div class="p-4 border-t border-gray-200 dark:border-gray-700 sepia:border-sepia-300">
          <div class="space-y-4">
            {/* Language Selection */}
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-2">
                {locale === 'vi' ? 'Ngôn ngữ' : 'Language'}
              </label>
              <div class="flex gap-2">
                <button 
                  type="button"
                  data-mobile-lang="vi"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                >
                  Tiếng Việt
                </button>
                <button 
                  type="button"
                  data-mobile-lang="en"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                >
                  English
                </button>
              </div>
            </div>
            
            {/* Theme Selection */}
            <div>
              <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-2">
                {locale === 'vi' ? 'Giao diện' : 'Theme'}
              </label>
              <div class="flex gap-2">
                <button 
                  type="button"
                  data-mobile-theme="light"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Light"
                  aria-label={locale === 'vi' ? 'Giao diện sáng' : 'Light theme'}
                >
                  <Sun class="w-4 h-4 mx-auto" aria-hidden="true" />
                </button>
                <button 
                  type="button"
                  data-mobile-theme="sepia"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Sepia"
                  aria-label={locale === 'vi' ? 'Giao diện giấy' : 'Sepia theme'}
                >
                  <BookOpenText class="w-4 h-4 mx-auto" aria-hidden="true" />
                </button>
                <button 
                  type="button"
                  data-mobile-theme="dark"
                  class="flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 sepia:bg-sepia-200 hover:bg-gray-200 dark:hover:bg-gray-700 sepia:hover:bg-sepia-300"
                  title="Dark"
                  aria-label={locale === 'vi' ? 'Giao diện tối' : 'Dark theme'}
                >
                  <Moon class="w-4 h-4 mx-auto" aria-hidden="true" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <header class="sticky top-0 z-30 hairline border-x-0 border-t-0 bg-white dark:bg-gray-900 sepia:bg-sepia-100 transition-colors">
      <nav class="max-w-6xl mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <a href={getLocalizedHomeUrl(locale)} class="text-xl md:text-2xl font-serif font-semibold tracking-tight ui-link no-underline hover:no-underline">
            My Blog
          </a>
          
          {/* Mobile menu button */}
          <button 
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 sepia:hover:bg-sepia-200 transition-colors"
            aria-label="Toggle menu"
            aria-controls="mobile-menu-sidebar"
            aria-expanded="false"
          >
            <MenuIcon class="w-6 h-6" aria-hidden="true" />
          </button>
          
          {/* Desktop navigation */}
          <div class="hidden md:flex items-center gap-4">
            <div class="flex gap-6">
              <a href={getLocalizedHomeUrl(locale)} class="ui-link no-underline hover:no-underline">{t('nav.home', locale)}</a>
              <a href={getLocalizedBlogUrl(locale)} class="ui-link no-underline hover:no-underline">{t('nav.blog', locale)}</a>
              <a href={getLocalizedBooksUrl(locale)} class="ui-link no-underline hover:no-underline">{t('nav.books', locale)}</a>
              <a href={getLocalizedAboutUrl(locale)} class="ui-link no-underline hover:no-underline">{t('nav.about', locale)}</a>
            </div>
            <LanguageSwitcher currentLocale={locale} />
            <ThemeToggle />
          </div>
        </div>
      </nav>
    </header>

    <script src="../scripts/mobileMenu.ts"></script>

    <main class="max-w-6xl mx-auto px-4 py-12">
      <slot />
    </main>

    <footer class="hairline border-x-0 border-b-0 mt-20">
      <div class="max-w-6xl mx-auto px-4 py-10 space-y-8">
        <div class="grid gap-8 md:grid-cols-3">
          <section>
            <h2 class="text-xs uppercase tracking-[0.18em] text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-4">
              {t('footer.pillarArticles', locale)}
            </h2>
            <div class="space-y-3">
              {pillarPosts.map(({ slug, post }) => (
                <a
                  href={getPostUrl(post!)}
                  class="block ui-link no-underline hover:no-underline"
                >
                  <p class="text-xs uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400 sepia:text-sepia-700 mb-1">
                    {getTopicInfo(slug, locale).name}
                  </p>
                  <p class="font-medium text-gray-800 dark:text-gray-200 sepia:text-sepia-900">
                    {post!.data.title}
                  </p>
                </a>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-xs uppercase tracking-[0.18em] text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-4">
              {t('footer.topicHubs', locale)}
            </h2>
            <div class="space-y-3">
              <a href={getLocalizedTopicsUrl(locale)} class="block ui-link no-underline hover:no-underline">
                {t('footer.browseAllTopicHubs', locale)}
              </a>
              {topicHubs.map((topic) => (
                <a
                  href={topic.url}
                  class="block ui-link no-underline hover:no-underline"
                >
                  {topic.name}
                </a>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-xs uppercase tracking-[0.18em] text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-4">
              {t('footer.categoryArchives', locale)}
            </h2>
            <div class="space-y-3">
              <a href={getLocalizedCategoriesUrl(locale)} class="block ui-link no-underline hover:no-underline">
                {t('footer.browseAllCategories', locale)}
              </a>
              {categoryHubs.map((category) => (
                <a
                  href={category.url}
                  class="block ui-link no-underline hover:no-underline"
                >
                  {category.label}
                </a>
              ))}
            </div>
          </section>
        </div>

        <div class="text-center text-gray-600 dark:text-gray-400 sepia:text-sepia-700 pt-4 border-t border-gray-200 dark:border-gray-700 sepia:border-sepia-300">
          <p>&copy; {new Date().getFullYear()} {t('footer.copyright', locale)}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
