---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../../utils/i18n';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TopicCard from '../../../components/TopicCard.astro';
import { TOPICS, getTopicInfo } from '../../../utils/topics';
import { generateTopicsBreadcrumbs } from '../../../utils/breadcrumbs';
import { getPublishedPosts } from '../../../lib/content/posts';
import { getLocaleStaticPaths, getLocalizedPageAlternates } from '../../../utils/localeRoute';
import { getLocalizedTopicUrl, isLocale } from '../../../utils/routing';

export const prerender = true;

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale: localeParam } = Astro.params;
if (!isLocale(localeParam)) return Astro.redirect('/404');
const locale: Locale = localeParam;
const allPosts = await getPublishedPosts(locale);
const baseUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const breadcrumbs = generateTopicsBreadcrumbs(baseUrl, locale);
const topicEntries = Object.keys(TOPICS).map((slug) => ({
  slug,
  count: allPosts.filter((post) => !!post.data.translationKey && TOPICS[slug as keyof typeof TOPICS].translationKeys.includes(post.data.translationKey)).length,
  info: getTopicInfo(slug as keyof typeof TOPICS, locale),
}));
const pageUrl = `${baseUrl}${Astro.url.pathname}`;
const topicsCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('topic.hubs', locale),
  description: t('topic.hubsSubtitle', locale),
  url: pageUrl,
  inLanguage: locale === 'vi' ? 'vi-VN' : 'en-US',
  mainEntity: { '@type': 'ItemList', numberOfItems: topicEntries.length, itemListElement: topicEntries.map((topic, index) => ({ '@type': 'ListItem', position: index + 1, url: `${baseUrl}${getLocalizedTopicUrl(locale, topic.slug)}`, name: topic.info.name })) },
};
---

<BaseLayout title={t('topic.hubsTitle', locale)} description={t('topic.hubsSubtitle', locale)} locale={locale} canonicalUrl={pageUrl} alternateUrls={getLocalizedPageAlternates(baseUrl, 'topics')} additionalJsonLd={[topicsCollectionSchema]}>
  <div class="space-y-12">
    <Breadcrumbs items={breadcrumbs} />
    <section class="text-center space-y-4 py-12">
      <h1 class="font-serif text-5xl md:text-6xl font-semibold tracking-tight">{t('topic.hubs', locale)}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 sepia:text-sepia-700 max-w-3xl mx-auto">{t('topic.hubsDescription', locale)}</p>
      <div class="card p-6 max-w-4xl mx-auto text-left"><h2 class="font-serif text-2xl font-semibold tracking-tight mb-3">{t('topic.whatHubsFor', locale)}</h2><p class="text-gray-600 dark:text-gray-400 sepia:text-sepia-700">{locale === 'en' ? 'Each topic page is a curated entry point for searchers who want a pillar article, the supporting essays around it, and a cleaner reading path through the site.' : 'Mỗi topic page là một điểm vào được biên tập lại cho người tìm kiếm: có bài trụ cột, các bài vệ tinh xung quanh và một lộ trình đọc gọn hơn xuyên suốt site.'}</p></div>
    </section>
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">{topicEntries.map((topic) => <TopicCard slug={topic.slug as keyof typeof TOPICS} locale={locale} count={topic.count} />)}</section>
  </div>
</BaseLayout>
