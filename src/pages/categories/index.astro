---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../utils/i18n';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { CATEGORIES, getCategoryDescription, getCategoryLabel, type CategoryKey } from '../../utils/categories';
import { generateCategoriesBreadcrumbs } from '../../utils/breadcrumbs';

const urlParams = Astro.url.searchParams;
const langParam = urlParams.get('lang');
const locale: Locale = (langParam === 'en' || langParam === 'vi') ? langParam : 'vi';

const allPosts = await getCollection('blog');
const baseUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const breadcrumbs = generateCategoriesBreadcrumbs(baseUrl, locale);
const categoryEntries = (Object.keys(CATEGORIES) as CategoryKey[]).map((slug) => ({
  slug,
  count: allPosts.filter((post) => !post.data.draft && post.data.lang === locale && post.data.category === slug).length,
}));
const pageUrl = `${baseUrl}/categories${locale === 'en' ? '?lang=en' : '?lang=vi'}`;
const categoriesCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: locale === 'en' ? 'Category Archives' : 'Kho category',
  description: locale === 'en'
    ? 'Browse blog archives by category: programming, lifestyle, and personal.'
    : 'Duyệt blog theo category: lập trình, đời sống và cá nhân.',
  url: pageUrl,
  inLanguage: locale === 'vi' ? 'vi-VN' : 'en-US',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categoryEntries.length,
    itemListElement: categoryEntries.map((category, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${baseUrl}/categories/${category.slug}${locale === 'en' ? '?lang=en' : '?lang=vi'}`,
      name: getCategoryLabel(category.slug, locale),
    })),
  },
};
---

<BaseLayout
  title={locale === 'en' ? 'Category Archives | Loc Nguyen' : 'Kho category | Lộc Nguyễn'}
  description={locale === 'en'
    ? 'Browse blog archives by category: programming, lifestyle, and personal.'
    : 'Duyệt blog theo category: lập trình, đời sống và cá nhân.'}
  locale={locale}
  additionalJsonLd={[categoriesCollectionSchema]}
>
  <div class="space-y-12">
    <Breadcrumbs items={breadcrumbs} />

    <section class="text-center space-y-4 py-12">
      <h1 class="font-serif text-5xl md:text-6xl font-semibold tracking-tight">
        {locale === 'en' ? 'Category Archives' : 'Kho Category'}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 sepia:text-sepia-700 max-w-3xl mx-auto">
        {locale === 'en'
          ? 'Use category pages when you want a cleaner archive by intent, not just a long reverse-chronological list.'
          : 'Dùng các trang category khi bạn muốn duyệt nội dung theo ý định đọc, thay vì chỉ xem danh sách bài theo thời gian.'}
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categoryEntries.map((category) => (
        <CategoryCard slug={category.slug} locale={locale} count={category.count} />
      ))}
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categoryEntries.map((category) => (
        <article class="card p-6">
          <h2 class="font-serif text-2xl font-semibold tracking-tight mb-3">
            {getCategoryLabel(category.slug, locale)}
          </h2>
          <p class="text-gray-600 dark:text-gray-400 sepia:text-sepia-700">
            {getCategoryDescription(category.slug, locale)}
          </p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
