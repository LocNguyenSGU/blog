---
import { CATEGORIES, type CategoryKey } from '../../utils/categories';
import { buildLegacyRedirectUrl, getLegacyLocaleFromUrl } from '../../utils/legacyRedirect';
import { getLocalizedCategoryUrl } from '../../utils/routing';

const { slug } = Astro.params;

if (!slug || !(slug in CATEGORIES)) {
  return Astro.redirect('/404');
}

return Astro.redirect(
  buildLegacyRedirectUrl(
    Astro.url,
    getLocalizedCategoryUrl(getLegacyLocaleFromUrl(Astro.url), slug as CategoryKey)
  ),
  301
);
---
