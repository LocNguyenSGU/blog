---
import { isTopicSlug } from '../../utils/topics';
import { buildLegacyRedirectUrl, getLegacyLocaleFromUrl } from '../../utils/legacyRedirect';
import { getLocalizedTopicUrl } from '../../utils/routing';

const { slug } = Astro.params;

if (!slug || !isTopicSlug(slug)) {
  return Astro.redirect('/404');
}

return Astro.redirect(
  buildLegacyRedirectUrl(Astro.url, getLocalizedTopicUrl(getLegacyLocaleFromUrl(Astro.url), slug)),
  301
);
---
