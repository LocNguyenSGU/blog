---
import { getAllBooks } from '../../lib/content/books';
import { buildLegacyRedirectUrl, getLegacyLocaleFromUrl } from '../../utils/legacyRedirect';
import { getLocalizedBookUrl } from '../../utils/routing';
import { toPublicSlug } from '../../utils/slugs';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const allBooks = await getAllBooks();
const locale = getLegacyLocaleFromUrl(Astro.url);
const matchingBooks = allBooks.filter((book) => toPublicSlug(book.slug, book.data.lang) === slug);

if (matchingBooks.length === 0) {
  return Astro.redirect('/404');
}

let targetBook = matchingBooks.find((book) => book.data.lang === locale) ?? null;

if (!targetBook) {
  targetBook = matchingBooks[0];
}

return Astro.redirect(
  buildLegacyRedirectUrl(Astro.url, getLocalizedBookUrl(targetBook.data.lang, targetBook.slug)),
  301
);
---
