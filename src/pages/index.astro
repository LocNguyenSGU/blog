---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import TopicCard from '../components/TopicCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getTopicInfo, type TopicSlug } from '../utils/topics';
import type { CategoryKey } from '../utils/categories';
import { getAllBlogPosts, getCategoryCounts, getPillarTopics, getPublishedPosts, getTopicCounts } from '../lib/content/posts';

const urlParams = Astro.url.searchParams;
const langParam = urlParams.get('lang');
const locale: Locale = (langParam === 'en' || langParam === 'vi') ? langParam : 'vi';

let allPosts: CollectionEntry<'blog'>[] = [];
let publishedPosts: CollectionEntry<'blog'>[] = [];
let featuredPost: CollectionEntry<'blog'> | null = null;
let recentPosts: CollectionEntry<'blog'>[] = [];
let topicCounts: Array<{ slug: TopicSlug; count: number }> = [];
let categoryCounts: Array<{ slug: CategoryKey; count: number }> = [];
let pillarTopics: Array<{ slug: TopicSlug; post: CollectionEntry<'blog'> }> = [];
let errorMessage = '';

try {
  allPosts = await getAllBlogPosts();
  publishedPosts = await getPublishedPosts(locale);
  featuredPost = publishedPosts[0];
  recentPosts = publishedPosts.slice(1, 4); // Show 3 recent posts
  topicCounts = getTopicCounts(publishedPosts);
  categoryCounts = getCategoryCounts(publishedPosts);
  pillarTopics = getPillarTopics(allPosts, locale);
} catch (error) {
  console.error('Error loading blog posts:', error);
  errorMessage = locale === 'en' 
    ? 'Unable to load blog posts. Please try again later.'
    : 'Không thể tải bài viết. Vui lòng thử lại sau.';
}
---

<BaseLayout
  title={locale === 'en' ? 'Loc Nguyen Blog | Programming, AI, and Personal Growth' : 'Blog Lộc Nguyễn | Lập trình, AI và phát triển bản thân'}
  description={locale === 'en'
    ? 'Essays and practical guides about programming, AI, work, and personal growth.'
    : 'Các bài viết và hướng dẫn thực tế về lập trình, AI, công việc và phát triển bản thân.'}
  locale={locale}
>
  <div class="space-y-16">
    {/* Hero Section */}
    <section class="text-center space-y-6 py-12">
      <h1 class="font-serif text-5xl md:text-7xl font-semibold tracking-tight">
        {t('home.title', locale)}
      </h1>
      
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 sepia:text-sepia-700 max-w-2xl mx-auto">
        {t('home.subtitle', locale)}
      </p>

      <div class="flex gap-4 justify-center pt-4">
        <a 
          href="/blog" 
          class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
        >
          {t('home.readBlog', locale)}
        </a>
        <a 
          href="/about" 
          class="px-8 py-3 border-2 border-gray-300 dark:border-gray-700 sepia:border-sepia-400 rounded-lg hover:border-blue-600 dark:hover:border-blue-400 transition font-medium"
        >
          {t('home.aboutMe', locale)}
        </a>
      </div>
    </section>

    {/* Error Message */}
    {errorMessage && (
      <div class="bg-red-50 dark:bg-red-900/20 sepia:bg-red-100 border border-red-200 dark:border-red-800 sepia:border-red-300 rounded-lg p-6 text-center">
        <p class="text-red-600 dark:text-red-400 sepia:text-red-700">{errorMessage}</p>
      </div>
    )}

    {/* Featured Post */}
    {!errorMessage && featuredPost && (
      <section>
        <h2 class="font-serif text-3xl font-semibold tracking-tight mb-6">{t('home.featured', locale)}</h2>
        <FeaturedPost post={featuredPost} />
      </section>
    )}

    {/* Recent Posts */}
    {!errorMessage && recentPosts.length > 0 && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="font-serif text-3xl font-semibold tracking-tight">{t('home.recent', locale)}</h2>
          <a 
            href="/blog" 
            class="ui-link font-medium"
          >
            {t('home.viewAll', locale)}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map(post => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}

    {!errorMessage && pillarTopics.length > 0 && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="font-serif text-3xl font-semibold tracking-tight">{locale === 'en' ? 'Start with Pillar Articles' : 'Bắt đầu với bài trụ cột'}</h2>
          <a
            href={`/topics${locale === 'en' ? '?lang=en' : ''}`}
            class="ui-link font-medium"
          >
            {locale === 'en' ? 'See topic architecture →' : 'Xem cấu trúc chủ đề →'}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {pillarTopics.map(({ slug, post }) => (
            <a
              href={`/blog/${post.slug}${locale === 'en' ? '?lang=en' : ''}`}
              class="block card p-6"
            >
              <p class="text-xs uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400 sepia:text-sepia-700 mb-3">
                {getTopicInfo(slug, locale).name}
              </p>
              <h3 class="font-serif text-2xl font-semibold tracking-tight mb-3 text-gray-900 dark:text-gray-100 sepia:text-sepia-900">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="text-sm text-gray-600 dark:text-gray-400 sepia:text-sepia-700 mb-4">
                  {post.data.description}
                </p>
              )}
              <p class="text-sm ui-link no-underline hover:no-underline font-medium">
                {locale === 'en' ? 'Read pillar article →' : 'Đọc bài trụ cột →'}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    {!errorMessage && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="font-serif text-3xl font-semibold tracking-tight">{locale === 'en' ? 'Browse by Category' : 'Đọc Theo Category'}</h2>
          <a
            href={`/categories${locale === 'en' ? '?lang=en' : '?lang=vi'}`}
            class="ui-link font-medium"
          >
            {locale === 'en' ? 'View category archives →' : 'Xem kho category →'}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {categoryCounts.map((category) => (
            <CategoryCard slug={category.slug} locale={locale} count={category.count} />
          ))}
        </div>
      </section>
    )}

    {!errorMessage && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="font-serif text-3xl font-semibold tracking-tight">{locale === 'en' ? 'Explore by Topic' : 'Đọc Theo Chủ Đề'}</h2>
          <a
            href={`/topics${locale === 'en' ? '?lang=en' : ''}`}
            class="ui-link font-medium"
          >
            {locale === 'en' ? 'View topic hubs →' : 'Xem các hub chủ đề →'}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {topicCounts.map((topic) => (
            <TopicCard slug={topic.slug} locale={locale} count={topic.count} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
