---
import { buildLegacyRedirectUrl, getLegacyLocaleFromUrl } from '../../utils/legacyRedirect';
import { getLocalizedBlogUrl } from '../../utils/routing';

return Astro.redirect(
  buildLegacyRedirectUrl(
    Astro.url,
    getLocalizedBlogUrl(getLegacyLocaleFromUrl(Astro.url)),
    { preserveKeys: ['category', 'topic'] }
  ),
  301
);
---
