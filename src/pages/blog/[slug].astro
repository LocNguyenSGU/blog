---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Get slug from URL params
const { slug } = Astro.params;

let entry = null;
let Content = null;
let headings = [];

try {
  // Find the post by slug
  const allPosts = await getCollection('blog');
  entry = allPosts.find(post => post.slug === slug);

  if (!entry) {
    return Astro.redirect('/404');
  }

  const rendered = await entry.render();
  Content = rendered.Content;
  headings = rendered.headings; // Get headings from rendered content
} catch (error) {
  console.error('Error loading blog post:', error);
  return Astro.redirect('/404');
}
---

<BlogPost {...entry.data} slug={entry.slug} body={entry.body} headings={headings} lang={entry.data.lang} tags={entry.data.tags}>
  <Content />
</BlogPost>
