---
import { getAllBlogPosts } from '../../lib/content/posts';
import { buildLegacyRedirectUrl, getLegacyLocaleFromUrl } from '../../utils/legacyRedirect';
import { getLocalizedBlogPostUrl } from '../../utils/routing';
import { toPublicSlug } from '../../utils/slugs';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const locale = getLegacyLocaleFromUrl(Astro.url);
const allPosts = await getAllBlogPosts();
const matchingPosts = allPosts.filter((post) => toPublicSlug(post.slug, post.data.lang) === slug);

if (matchingPosts.length === 0) {
  return Astro.redirect('/404');
}

let targetPost = matchingPosts.find((post) => post.data.lang === locale) ?? null;

if (!targetPost) {
  const referencePost = matchingPosts[0];
  targetPost = referencePost.data.translationKey
    ? allPosts.find(
        (post) =>
          post.data.translationKey === referencePost.data.translationKey &&
          post.data.lang === locale
      ) ?? referencePost
    : referencePost;
}

return Astro.redirect(
  buildLegacyRedirectUrl(Astro.url, getLocalizedBlogPostUrl(targetPost.data.lang, targetPost.slug)),
  301
);
---
