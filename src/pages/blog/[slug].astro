---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostBySlug } from '../../lib/content/posts';

// Get slug from URL params
const { slug } = Astro.params;

let entry: CollectionEntry<'blog'> | null = null;
let Content = null;
let headings: MarkdownHeading[] = [];

try {
  entry = slug ? await getPostBySlug(slug) ?? null : null;

  if (!entry) {
    return Astro.redirect('/404');
  }

  const rendered = await entry.render();
  Content = rendered.Content;
  headings = rendered.headings; // Get headings from rendered content
} catch (error) {
  console.error('Error loading blog post:', error);
  return Astro.redirect('/404');
}
---

<BlogPost {...entry.data} slug={entry.slug} body={entry.body} headings={headings} lang={entry.data.lang} tags={entry.data.tags}>
  <Content />
</BlogPost>
