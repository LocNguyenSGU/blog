# Site Configuration
# Base URL for the site (used for canonical URLs and SEO)
# Example: https://yourblog.com or https://yourblog.vercel.app
PUBLIC_SITE_URL=http://localhost:4321

# Giscus Comments Configuration
# Generate at: https://giscus.app
# Follow guide: docs/GISCUS-SETUP.md
PUBLIC_GISCUS_REPO=your-username/your-repo
PUBLIC_GISCUS_REPO_ID=YOUR_REPO_ID
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=YOUR_CATEGORY_ID

# Deployment Settings
# These are typically set by your hosting provider (e.g., Vercel)
# but can be overridden if needed

# VERCEL_URL - Automatically set by Vercel during deployment
# VERCEL_ENV - Automatically set by Vercel (production, preview, development)

# Optional: Analytics and Monitoring
# Add any third-party service keys here if needed
# ANALYTICS_ID=
# SENTRY_DSN=
